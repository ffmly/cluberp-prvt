# Browser-safe application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key

# Server-only keys. Leave unset until the associated integration is configured.
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CANVA_CLIENT_ID=replace-with-client-id
CANVA_CLIENT_SECRET=replace-with-client-secret
CANVA_REDIRECT_URI=http://localhost:3000/api/integrations/canva/callback
EMAIL_PROVIDER_API_KEY=replace-with-provider-key
SENTRY_DSN=replace-with-dsn
RATE_LIMIT_REDIS_URL=replace-with-redis-url
RATE_LIMIT_REDIS_TOKEN=replace-with-redis-token
